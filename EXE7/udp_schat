#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <signal.h>

#define BUFFER_SIZE 1024

int main(int argc, char *argv[])
{
    int sockfd;
    char buffer[BUFFER_SIZE];

    struct sockaddr_in server_addr, client_addr;
    socklen_t client_len;

    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    // Create UDP socket
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        return 1;
    }

    // Initialize server address
    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = htonl(INADDR_ANY);
    server_addr.sin_port = htons(atoi(argv[1]));

    // Bind socket
    if (bind(sockfd,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("Bind failed");
        close(sockfd);
        return 1;
    }

    printf("====================================\n");
    printf("   Concurrent UDP Chat Server\n");
    printf("====================================\n");
    printf("Server running on port %s\n", argv[1]);
    printf("Waiting for clients...\n\n");

    while (1)
    {
        client_len = sizeof(client_addr);

        // Receive message from client
        int n = recvfrom(sockfd,
                         buffer,
                         BUFFER_SIZE - 1,
                         0,
                         (struct sockaddr *)&client_addr,
                         &client_len);

        if (n < 0)
        {
            perror("recvfrom failed");
            continue;
        }

        buffer[n] = '\0';

        printf("Message received from %s:%d\n",
               inet_ntoa(client_addr.sin_addr),
               ntohs(client_addr.sin_port));

        printf("Client: %s\n", buffer);

        /*
         * Create a child process to handle this client
         */
        pid_t pid = fork();

        if (pid < 0)
        {
            perror("Fork failed");
            continue;
        }

        if (pid == 0)
        {
            // CHILD PROCESS

            char reply[BUFFER_SIZE];

            printf("\nChild Process [%d] handling client...\n",
                   getpid());

            printf("Server: ");
            fflush(stdout);

            if (fgets(reply, BUFFER_SIZE, stdin) == NULL)
            {
                exit(0);
            }

            reply[strcspn(reply, "\n")] = '\0';

            // Send reply to client
            sendto(sockfd,
                   reply,
                   strlen(reply),
                   0,
                   (struct sockaddr *)&client_addr,
                   client_len);

            printf("Reply sent to client.\n\n");

            close(sockfd);
            exit(0);
        }

        // PARENT PROCESS
        // Continue receiving messages from other clients

        waitpid(-1, NULL, WNOHANG);
    }

    close(sockfd);

    return 0;
}
