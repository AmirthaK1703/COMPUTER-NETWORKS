#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

struct Request {
    float num1;
    float num2;
    char op;
};

int main()
{
    int sockfd;
    struct sockaddr_in server;
    socklen_t len = sizeof(server);

    struct Request req;
    char response[100];

    // Create UDP socket
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    // Server address
    server.sin_family = AF_INET;
    server.sin_port = htons(8022);
    server.sin_addr.s_addr = inet_addr("127.0.0.1");

    // Get input
    printf("Enter first number: ");
    scanf("%f", &req.num1);

    printf("Enter operator (+ - * /): ");
    scanf(" %c", &req.op);

    printf("Enter second number: ");
    scanf("%f", &req.num2);

    // Send request to server
    sendto(sockfd, &req, sizeof(req), 0,
           (struct sockaddr *)&server, len);

    // Receive result
    recvfrom(sockfd, response, sizeof(response), 0,
             (struct sockaddr *)&server, &len);

    printf("\nServer Response: %s\n", response);

    close(sockfd);

    return 0;
}
