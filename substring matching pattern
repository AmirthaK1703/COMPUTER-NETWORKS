class Solution {
public:
    bool hasMatch(string s, string p) {
        
        int starIdx = p.find('*');
        string p1 = p.substr(0, starIdx);
        string p2 = p.substr(starIdx + 1);

        size_t i_min = s.find(p1);
        size_t j_max = s.rfind(p2);

        if (i_min == string::npos || j_max == string::npos) {
            return false;
        }

        return j_max >= i_min + p1.length();
    }
};

     
